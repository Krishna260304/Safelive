# ==============================================================================
# SafeLive RPi 5 IoT Edge Device Configuration
# ==============================================================================

# Device Identification
DEVICE_ID=rpi5-safelive-unit-01
DEVICE_NAME="SafeLive RPi 5 Patrol Unit #1"
WIFI_SSID=SafeLive-RPi5-01
# Device password required by Field Inspector to connect locally
DEVICE_PASSWORD=safelive2026
DEVICE_SECRET_KEY=safelive-edge-secret-key-rpi5
SCOPE=city
SOURCE=rpi5_edge

# Safelive Central Server Endpoint (Receives ONLY detected incidents)
SERVER_URL=https://safelive.in/api/iot/incidents
IOT_API_KEY=
SERVER_SYNC_ENABLED=true
SERVER_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3

# Camera Configuration
# Options: 'v4l2' (USB Camera), 'picamera2' (RPi CSI Camera), 'stream' (RTSP), 'test' (Synthetic simulator)
CAMERA_TYPE=v4l2
CAMERA_INDEX=0
STREAM_URL=
FRAME_WIDTH=640
FRAME_HEIGHT=360
TARGET_FPS=15

# GPS Configuration (NEO-6M / NEO-8M / USB GPS)
# Common ports: /dev/ttyUSB0, /dev/serial0 (UART GPIO 14/15)
GPS_PORT=/dev/ttyUSB0
GPS_BAUDRATE=9600
GPS_TIMEOUT=1.0
GPS_MOCK_FALLBACK=true
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946

# YOLOv8 ML Model Settings
YOLO_MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
INFERENCE_DEVICE=cpu
INFERENCE_FPS_LIMIT=2.0
INFERENCE_SIZE=640
MAX_DETECTIONS=50
SAVE_ANNOTATED_SNAPSHOTS=true

# Incident Debounce & Anti-Spam
DISTANCE_DEBOUNCE_METERS=30.0
COOLDOWN_SECONDS=45.0
MIN_SEVERITY=medium

# Local Web & Live Streaming Server (Field Inspector Wi-Fi direct connection)
LOCAL_SERVER_HOST=0.0.0.0
LOCAL_SERVER_PORT=8080
ENABLE_LOCAL_SERVER=true
